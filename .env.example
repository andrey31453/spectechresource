# Скопировать в .env и заполнить. .env в git не попадает.

# --- База данных (локально поднимается через docker compose) ---
DATABASE_URL="postgresql://spectech:spectech@localhost:5432/spectech?schema=public"

# --- Битрикс24: входящий вебхук (секрет, используется только на сервере) ---
BITRIX24_WEBHOOK_URL="https://<portal>.bitrix24.ru/rest/1/<token>/crm.lead.add.json"

# --- Сессии админки. Сгенерировать: openssl rand -base64 32 ---
SESSION_SECRET=""

# --- Публичные значения ---
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
# Резервный ID Метрики, если не задан в настройках сайта в админке
NUXT_PUBLIC_METRIKA_ID=""

# --- Локальная разработка: не отправлять лиды в реальную CRM ---
LEADS_DRY_RUN="true"
