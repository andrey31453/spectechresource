[Unit]
Description=Spectechresource Nuxt application
After=network.target postgresql.service

[Service]
Type=simple
User=spectech
Group=spectech
WorkingDirectory=/opt/spectech/current
EnvironmentFile=/opt/spectech/shared/app.env
ExecStart=/usr/local/bin/node /opt/spectech/current/.output/server/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/spectech/shared/uploads
UMask=0027

[Install]
WantedBy=multi-user.target